    <AddGameplayScripts id="GameplayScripts">
      <File>AssistantTopics.lua</File>
      <File>CallTopicFunctions.lua</File>
      <File>SummonAssistant.lua</File>
    </AddGameplayScripts>
    <AddUserInterfaces id="AssistantPanel">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>UI/AssistantPanel.xml</File>
    </AddUserInterfaces>
    <UpdateArt id="Art">
      <File>PlanaAssistant.dep</File>
    </UpdateArt>
  </InGameActions>
  <ImportFiles>
    <File>AssistantTopics_UI.lua</File>
    <File>AssistantTopics_Call_UI.lua</File>
  </ImportFiles>
